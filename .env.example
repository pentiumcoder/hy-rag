# Copy to .env and adjust. Every value is optional; defaults run fully locally.

# Where source documents live and where processed data/indexes are written.
HYRAG_CORPUS_DIR=data/corpus
HYRAG_DATA_DIR=data
# Search indexes; empty means <data dir>/index. `hyrag eval` always uses <data dir>/eval-index.
HYRAG_INDEX_PATH=

# Chunking
HYRAG_CHUNK_STRATEGY=recursive
HYRAG_CHUNK_SIZE=800
HYRAG_CHUNK_OVERLAP=120
HYRAG_SEMANTIC_BREAKPOINT_PERCENTILE=20
HYRAG_SEMANTIC_MIN_CHARS=200
HYRAG_SEMANTIC_MAX_CHARS=1200

# Embeddings: "fastembed" (local bge-small, default), "openai" (needs OPENAI_API_KEY) or
# "fake" (deterministic, for tests). Models download to HYRAG_MODEL_CACHE_DIR on first use.
HYRAG_EMBEDDING_PROVIDER=fastembed
HYRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Vector size of the fake embedder only (tests and offline eval).
HYRAG_EMBEDDING_DIM=256
HYRAG_EMBEDDING_CACHE=true
HYRAG_MODEL_CACHE_DIR=.cache/models

# Indexing: skip a chunk whose cosine similarity to an indexed chunk exceeds this.
HYRAG_DEDUP_THRESHOLD=0.95

# Retrieval: dense + BM25 top-k, weighted RRF, cross-encoder rerank of the fused top-N.
HYRAG_DENSE_K=10
HYRAG_SPARSE_K=10
HYRAG_RRF_K=60
HYRAG_DENSE_WEIGHT=0.5
HYRAG_SPARSE_WEIGHT=0.5
HYRAG_FUSION_TOP_N=20
HYRAG_RERANKER=cross-encoder
HYRAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
HYRAG_TOP_K=5

# Generation: "ollama" (local, default), "openai", "anthropic" or "stub" (deterministic, for
# tests). Empty model names use the provider defaults: on Ollama qwen2.5:7b generates and
# llama3.1:8b judges citations, so the judge is a different model family.
HYRAG_LLM_PROVIDER=ollama
HYRAG_GENERATOR_MODEL=
HYRAG_JUDGE_PROVIDER=
HYRAG_JUDGE_MODEL=
HYRAG_OLLAMA_BASE_URL=http://localhost:11434
HYRAG_OLLAMA_NUM_CTX=8192
HYRAG_LLM_TIMEOUT=180
HYRAG_LLM_TEMPERATURE=0
HYRAG_GENERATOR_MAX_TOKENS=512
HYRAG_JUDGE_MAX_TOKENS=1024
HYRAG_LLM_CACHE=true

# Answering: verify each [n] citation with the judge, and abstain (generate nothing) when the
# retrieval confidence sigmoid((top rerank logit - center) / scale) is below the threshold.
HYRAG_VERIFY_CITATIONS=true
HYRAG_ABSTAIN_THRESHOLD=0.3
HYRAG_RERANK_CENTER=-4.0
HYRAG_RERANK_SCALE=2.0
# After verification, withdraw the answer when the judge finds the passages do not answer the
# question and no sentence is supported, or when the verified confidence is below the floor.
# Both thresholds are tuned by `hyrag eval` (see eval/results/report.md and ADR-0004).
HYRAG_ABSTAIN_ON_UNANSWERABLE=true
HYRAG_ANSWER_THRESHOLD=0.0

# Evaluation results served by GET /v1/eval/summary, and the origins allowed to call the API.
HYRAG_EVAL_RESULTS_DIR=eval/results
HYRAG_API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional hosted providers. Leave empty to stay local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
